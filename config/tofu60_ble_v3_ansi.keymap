#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "boards/shields/klink_kbd/common.keymap"

#define UF_RESET bootloader_reset 0 0
#define UF_BT1 device_bt1 0 0
#define UF_BT2 device_bt2 0 1
#define UF_BT3 device_bt3 0 2

/ {
    behaviors {
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;

            usb {
                sequence = <U S B>;
                bindings = <&out OUT_USB>;
            };

            ble {
                sequence = <B L E>;
                bindings = <&out OUT_BLE>;
            };

            bt0 {
                sequence = <B N0>;
                bindings = <&bt BT_SEL 0>;
            };

            bt1 {
                sequence = <B N1>;
                bindings = <&bt BT_SEL 1>;
            };

            bt2 {
                sequence = <B N2>;
                bindings = <&bt BT_SEL 2>;
            };
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Basic {
            bindings = <
&lt 4 ESC         &kp N1        &kp N2       &kp N3         &kp N4         &kp N5  &kp N6  &kp N7  &kp N8     &kp N9      &kp N0     &kp MINUS            &kp EQUAL  &kp BSLH       &kp GRAVE
&lt 3 TAB         &kp Q         &kp W        &kp E          &kp R          &kp T   &kp Y   &kp U   &kp I      &kp O       &kp P      &kp LBKT             &kp RBKT   &kp BACKSPACE
&kp LEFT_CONTROL  &kp A         &kp S        &kp D          &kp F          &kp G   &kp H   &kp J   &kp K      &kp L       &kp SEMI   &kp SQT              &kp RET
&kp LSHFT         &kp Z         &kp X        &kp C          &kp V          &kp B   &kp N   &kp M   &kp COMMA  &kp PERIOD  &kp SLASH  &mt RIGHT_SHIFT F18  &lt 1 F18
&kp LEFT_ALT      &kp LEFT_GUI  &lt 2 SPACE  &kp RIGHT_GUI  &kp RIGHT_ALT
            >;
        };

        fn {
            bindings = <
&trans        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8    &kp F9          &kp F10               &kp F11    &kp F12  &kp INS  &kp DEL
&kp CAPSLOCK  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &kp SCROLLLOCK  &kp LS(LG(NUMBER_2))  &kp UP     &trans   &trans
&trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp PG_UP       &kp LEFT              &kp RIGHT  &trans
&trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp END   &kp PAGE_DOWN   &kp DOWN              &trans     &trans
&trans        &trans  &trans  &trans  &trans
            >;
        };

        space {
            bindings = <
&trans     &trans           &trans       &trans           &trans          &trans             &trans    &trans    &trans  &trans     &trans      &trans     &trans  &trans  &trans
&trans     &kp LC(GRAVE)    &kp LC(TAB)  &kp LC(LA(F2))   &kp LC(LA(F1))  &kp LS(LG(GRAVE))  &trans    &trans    &trans  &trans     &kp C_PLAY  &trans     &trans  &trans
&kp LCTRL  &trans           &trans       &trans           &kp F14         &trans             &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans      &trans     &trans
&kp LSHFT  &kp LA(LC(F15))  &trans       &kp PRINTSCREEN  &trans          &leader            &trans    &trans    &trans  &trans     &trans      &kp RSHFT  &trans
&kp LALT   &kp LGUI         &trans       &kp RGUI         &kp RALT
            >;
        };

        tab {
            bindings = <
&trans  &trans  &trans     &trans  &trans  &trans     &trans          &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans  &trans  &trans     &trans          &msc SCRL_DOWN  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans  &trans  &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &trans  &trans  &trans
&trans  &trans  &trans     &trans  &trans  &mkp LCLK  &mkp RCLK       &msc SCRL_UP    &trans          &trans           &trans  &trans  &trans
&trans  &trans  &kp SPACE  &trans  &trans
            >;
        };

        esc {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
